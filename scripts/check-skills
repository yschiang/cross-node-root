#!/usr/bin/env bash
# Check that the skills and tools this project's workflow uses are available (see README「怎麼開始」).
# Skills are committed in this repository (.claude/skills for Claude Code, .agents/skills for Codex and
# OpenCode); a personal copy is only reported, because Claude Code prefers ~/.claude/skills over the
# project copy when both exist.
set -u
REPO="$(cd "$(dirname "$0")/.." && pwd)"
SKILLS=(project-lead feature-to-spec spec-to-plan plan-to-code to-pr research-codebase
        grill-with-docs grilling domain-modeling brainstorming writing-plans test-driven-development
        subagent-driven-development using-git-worktrees requesting-code-review
        verification-before-completion finishing-a-development-branch
        openspec-update-change openspec-archive-change)
missing=0
for s in "${SKILLS[@]}"; do
  for d in "$REPO/.claude/skills" "$REPO/.agents/skills"; do
    if [ -f "$d/$s/SKILL.md" ]; then echo "ok       $s  (${d#$REPO/})"
    else echo "MISSING  $s  (${d#$REPO/})"; missing=$((missing+1)); fi
  done
  personal="$HOME/.claude/skills/$s"
  if [ -f "$personal/SKILL.md" ] && ! diff -rq "$personal" "$REPO/.claude/skills/$s" >/dev/null 2>&1; then
    echo "WARN     $s: ~/.claude/skills has a different copy; Claude Code will use that one"
  fi
done
if command -v openspec >/dev/null 2>&1; then echo "ok       openspec CLI $(openspec --version 2>/dev/null)"
else echo "MISSING  openspec CLI (npm i -g @fission-ai/openspec@1.13.1)"; missing=$((missing+1)); fi
[ "$missing" -eq 0 ] && echo "all present" || echo "$missing missing"
exit "$missing"
